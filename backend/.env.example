# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver for async SQLAlchemy, psycopg2 for Alembic sync operations
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/workflow_map
# Sync URL used only by Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@localhost:5432/workflow_map

# ── ID/PW Auth (Azure AD is planned for v2) ───────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Teams Notification (SMTP relay via Teams channel email) ───────────────────
TEAMS_NOTIFICATION_EMAIL=fc748c69.joycity.com@kr.teams.ms
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_FROM_EMAIL=workflow-map@joycity.com

# ── Git ───────────────────────────────────────────────────────────────────────
GIT_REMOTE_URL=https://github.com/joycityDSBI/workflow-map
GIT_REPO_LOCAL_PATH=/app/git-workspace

# ── Vertex AI (Claude via GCP) ────────────────────────────────────────────────
# 인증은 GCP ADC 자동 처리 — API 키 불필요
# VM: 서비스 계정 자동 인증 / 로컬: gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-east5
VERTEX_MODEL_ID=claude-sonnet-5@20251001

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
